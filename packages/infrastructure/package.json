{
  "name": "@careerden/infrastructure",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./logging": {
      "development": "./src/logging/index.ts",
      "types": "./dist/logging/index.d.ts",
      "default": "./dist/logging/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "smoke:playwright-pdf": "node scripts/smoke-playwright-pdf.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.104",
    "@ai-sdk/deepseek": "^3.0.86",
    "@ai-sdk/google": "^4.0.120",
    "@ai-sdk/openai": "^4.0.117",
    "@ai-sdk/openai-compatible": "^3.0.92",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@careerden/contracts": "workspace:*",
    "@careerden/domain": "workspace:*",
    "@electric-sql/pglite": "0.5.10",
    "ai": "^7.0.172",
    "bullmq": "^5.64.1",
    "ioredis": "^5.8.2",
    "knex": "^3.3.0",
    "knex-pglite": "0.14.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "playwright": "1.65.0",
    "resend": "^6.37.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  }
}
