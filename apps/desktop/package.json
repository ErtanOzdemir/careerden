{
  "name": "@careerden/desktop",
  "productName": "Careerden",
  "version": "0.7.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "pnpm run build:main && pnpm run build:renderer",
    "build:main": "tsc -p tsconfig.json && node scripts/prepare-main-build.mjs",
    "build:renderer": "pnpm --dir ../web exec vite build --outDir ../desktop/renderer --emptyOutDir",
    "dev": "pnpm run build:main && node scripts/wait-for-dev-servers.mjs && electron .",
    "package": "electron-builder --config electron-builder.yml --publish never",
    "package:local": "electron-builder --config electron-builder.local.yml --publish never",
    "rebuild": "echo 'No native desktop rebuild required'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@careerden/api-app": "workspace:*",
    "@careerden/application": "workspace:*",
    "@careerden/config": "workspace:*",
    "@careerden/contracts": "workspace:*",
    "@careerden/domain": "workspace:*",
    "@careerden/infrastructure": "workspace:*",
    "electron-updater": "^6.8.9",
    "semver": "^7.7.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/semver": "^7.7.1",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wait-on": "^9.5.1"
  }
}
