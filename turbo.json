{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "CAREERDEN_EDITION",
        "CAREERDEN_REQUIRE_DESKTOP_API_BASE_URL",
        "CAREERDEN_REQUIRE_DESKTOP_UPDATE_REPOSITORY",
        "DESKTOP_API_BASE_URL",
        "DESKTOP_UPDATE_REPOSITORY",
        "VITE_CAREERDEN_EDITION"
      ],
      "outputs": ["dist/**", "renderer/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "CAREERDEN_EDITION",
        "CAREERDEN_LOCAL_DEV_PORT",
        "CAREERDEN_LOCAL_DEV_TOKEN",
        "VITE_API_BASE_URL",
        "VITE_CAREERDEN_EDITION"
      ]
    }
  }
}
