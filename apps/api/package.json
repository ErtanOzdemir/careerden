{
  "name": "@careerden/api-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --import ./src/tracing.register.ts src/server.ts",
    "start": "node --import ./dist/tracing.register.js dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.932.0",
    "@aws-sdk/s3-request-presigner": "^3.932.0",
    "@careerden/application": "workspace:*",
    "@careerden/config": "workspace:*",
    "@careerden/contracts": "workspace:*",
    "@careerden/domain": "workspace:*",
    "@careerden/infrastructure": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-prometheus": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.220.0",
    "@opentelemetry/instrumentation-http": "^0.220.0",
    "@opentelemetry/instrumentation-pg": "^0.72.0",
    "@opentelemetry/instrumentation-redis": "^0.68.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "better-auth": "^1.3.34",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "import-in-the-middle": "^3.3.0",
    "knex": "^3.1.0",
    "multer": "^2.2.0",
    "pg": "^8.16.3",
    "playwright": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
