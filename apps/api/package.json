{
  "name": "@careerden/api-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": {
      "default": "./dist/server.js"
    },
    "./local": {
      "development": "./src/local/index.ts",
      "types": "./dist/local/index.d.ts",
      "default": "./dist/local/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --conditions=development --import ./src/tracing.register.ts src/server.ts",
    "start": "node --import ./dist/tracing.register.js dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "fixture:pglite": "node scripts/generate-pglite-fixture.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@careerden/application": "workspace:*",
    "@careerden/config": "workspace:*",
    "@careerden/contracts": "workspace:*",
    "@careerden/domain": "workspace:*",
    "@careerden/infrastructure": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "@opentelemetry/exporter-prometheus": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.1",
    "@opentelemetry/instrumentation-http": "^0.301.1",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-redis": "^0.73.0",
    "@opentelemetry/sdk-node": "^0.301.1",
    "better-auth": "^1.7.19",
    "cors": "^2.8.5",
    "creem": "1.13.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fflate": "^0.8.2",
    "import-in-the-middle": "^3.6.0",
    "knex": "^3.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "playwright": "1.65.0",
    "unpdf": "1.3.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-tools": "0.4.16",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1",
    "ai": "^6.0.0",
    "knex-pglite": "0.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
