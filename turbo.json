{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "CAREERDEN_REQUIRE_DESKTOP_API_BASE_URL",
        "CAREERDEN_REQUIRE_DESKTOP_UPDATE_REPOSITORY",
        "DESKTOP_API_BASE_URL",
        "DESKTOP_UPDATE_REPOSITORY"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
