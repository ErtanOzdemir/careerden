{
  "name": "@careerden/infrastructure",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && mkdir -p dist/documents/templates dist/persistence/postgres-migrations && cp src/documents/templates/*.html dist/documents/templates/ && cp src/persistence/postgres-migrations/*.cjs dist/persistence/postgres-migrations/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.0",
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@aws-sdk/client-s3": "^3.932.0",
    "@aws-sdk/s3-request-presigner": "^3.932.0",
    "@careerden/contracts": "workspace:*",
    "@careerden/domain": "workspace:*",
    "ai": "^6.0.0",
    "bullmq": "^5.64.1",
    "docxtemplater": "^3.68.7",
    "ioredis": "^5.8.2",
    "knex": "^3.1.0",
    "nodemailer": "^9.0.3",
    "pizzip": "^3.2.0",
    "pg": "^8.16.3",
    "playwright": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
