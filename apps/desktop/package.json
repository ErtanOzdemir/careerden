{
  "name": "@link2cv/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/preload/index.cjs dist/preload/index.cjs",
    "dev": "tsc -p tsconfig.json && cp src/preload/index.cjs dist/preload/index.cjs && electron .",
    "rebuild": "echo 'No native desktop rebuild required'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@link2cv/config": "workspace:*",
    "@link2cv/contracts": "workspace:*",
    "@link2cv/domain": "workspace:*",
    "@link2cv/infrastructure": "workspace:*",
    "playwright": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
