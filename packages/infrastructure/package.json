{
  "name": "@link2cv/infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/documents/templates dist/persistence/migrations && cp src/documents/templates/*.html dist/documents/templates/ && cp src/persistence/migrations/*.cjs dist/persistence/migrations/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.0",
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@aws-sdk/client-s3": "^3.744.0",
    "@aws-sdk/s3-request-presigner": "^3.744.0",
    "@link2cv/contracts": "workspace:*",
    "@link2cv/domain": "workspace:*",
    "ai": "^6.0.0",
    "bullmq": "^5.34.2",
    "docxtemplater": "^3.68.7",
    "ioredis": "^5.4.2",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "pizzip": "^3.2.0",
    "playwright": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
