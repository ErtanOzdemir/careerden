NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://careerden:careerden@localhost:5432/careerden
REDIS_URL=redis://localhost:6380
BULLSTUDIO_PORT=4000
BULLSTUDIO_POLL_INTERVAL=5000
# Development only. Generate a production value with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-careerden-better-auth-secret
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
# Auth endpoint rate limits (per IP and per email for verification codes).
AUTH_RATE_LIMIT_ENABLED=true
# Comma-separated reverse-proxy CIDRs in front of the API, e.g. the Coolify/Traefik network.
# Required in production so X-Forwarded-For resolves to the real client IP.
AUTH_TRUSTED_PROXIES=
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_ID=
CREEM_PLAN_KEY=pro
CREEM_SUCCESS_URL=http://localhost:5173/billing?checkout=success
CREEM_TEST_MODE=true
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=Careerden <no-reply@careerden.local>
RESEND_API_KEY=
NOTIFICATION_EMAIL_ENABLED=true
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Users without a paid subscription use OpenCode's free Zen models through the opencode
# compose service; set AI_FREE_PROVIDER=premium to skip it locally.
AI_FREE_PROVIDER=opencode
OPENCODE_BASE_URL=http://localhost:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=dev-only-careerden-opencode-password
OPENCODE_FREE_MODEL=space-bunny-free
# Reasoning-effort variant; low keeps free-tier analyses fast.
OPENCODE_FREE_MODEL_VARIANT=low
# careerden is the tool-free production agent; build (OpenCode's coding agent) is for local
# experiments with test data only and is rejected in production.
OPENCODE_AGENT=careerden
OPENCODE_TIMEOUT_MS=120000
LLM_WORKER_CONCURRENCY=5
LLM_WORKER_HEALTH_PORT=3101
DOCUMENTS_WORKER_CONCURRENCY=1
DOCUMENTS_WORKER_HEALTH_PORT=3102
NOTIFICATIONS_WORKER_CONCURRENCY=1
NOTIFICATIONS_WORKER_HEALTH_PORT=3103
GOTENBERG_URL=http://localhost:3002
# Local RustFS defaults below are rejected when NODE_ENV=production.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=careerden
OBJECT_STORAGE_ACCESS_KEY_ID=rustfsadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=rustfsadmin
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
VITE_API_BASE_URL=http://localhost:3000
OPEN_OBSERVE_URL=http://localhost:5080
OPEN_OBSERVE_KEY=
