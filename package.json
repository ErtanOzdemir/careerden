{
  "name": "careerden",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm dev:services && turbo run dev --parallel",
    "dev:api": "pnpm --filter @careerden/api-app dev",
    "dev:llm-worker": "pnpm --filter @careerden/llm-worker dev",
    "dev:documents-worker": "pnpm --filter @careerden/documents-worker dev",
    "dev:notifications-worker": "pnpm --filter @careerden/notifications-worker dev",
    "dev:marketing": "pnpm --filter @careerden/marketing dev",
    "dev:services": "docker compose up -d --wait postgres redis rustfs",
    "migrate:make": "pnpm --filter @careerden/infrastructure exec knex migrate:make --knexfile knexfile.cjs",
    "migrate:latest": "pnpm --filter @careerden/infrastructure exec knex migrate:latest --knexfile knexfile.cjs",
    "migrate:rollback": "pnpm --filter @careerden/infrastructure exec knex migrate:rollback --knexfile knexfile.cjs",
    "migrate:up": "pnpm --filter @careerden/infrastructure exec knex migrate:up --knexfile knexfile.cjs",
    "migrate:down": "pnpm --filter @careerden/infrastructure exec knex migrate:down --knexfile knexfile.cjs",
    "migrate:status": "pnpm --filter @careerden/infrastructure exec knex migrate:status --knexfile knexfile.cjs",
    "dev:desktop": "turbo run dev --filter=@careerden/api-app --filter=@careerden/llm-worker --filter=@careerden/documents-worker --filter=@careerden/notifications-worker --filter=@careerden/web --filter=@careerden/desktop",
    "dev:desktop:local": "node scripts/dev-desktop-local.mjs",
    "seed:local-profile": "node scripts/seed-local-profile.mjs",
    "verify:desktop-release": "node apps/desktop/scripts/verify-desktop-release.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "tsx": "^4.19.2",
    "turbo": "2.9.18",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.61.0",
    "vitest": "^2.1.8"
  }
}
